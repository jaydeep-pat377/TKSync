# Copy to android/keystore.properties and fill in. That file is gitignored —
# never commit it, and keep the .jks itself outside the repo too.
#
# Generate once, then back it up somewhere safe. Losing it means you can never
# ship an update to the same Play listing again.
#
#   keytool -genkeypair -v -keystore tksync-release.jks \
#     -alias tksync -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=/absolute/path/to/tksync-release.jks
storePassword=
keyAlias=tksync
keyPassword=
