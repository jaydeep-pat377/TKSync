<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Overrides the release config so a dev build can talk to an
  HTTP API on the LAN and be inspected through a proxy. Never merged into
  release — see android/app/src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
